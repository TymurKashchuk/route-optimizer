# RouteWise Environment Configuration
# Copy this file to .env to override default settings:
# cp .env.example .env

# OpenRouteService API Key (optional)
# If left empty, RouteWise runs in offline/static mode with built-in coordinates and routing.
# Obtain a free key at: https://openrouteservice.org/dev/#/signup
OPENROUTE_SERVICE_API_KEY=
